# Upstash Redis (REST API) — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ethereal test SMTP/IMAP account — https://ethereal.email
# Generate one with: node -e "require('nodemailer').createTestAccount().then(a => console.log(a))"
ETHEREAL_USER=
ETHEREAL_PASS=

# Random 32+ character secret used to encrypt the session cookie
SESSION_PASSWORD=

# Base URL used to build links sent by email (no trailing slash)
APP_URL=http://localhost:3000
